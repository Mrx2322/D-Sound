<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"

    android:id="@+id/bottomNavigation"
    android:layout_width="match_parent"
    android:layout_height="76dp"

    android:background="@drawable/bg_bottom_navigation"

    android:gravity="center"
    android:orientation="horizontal"

    android:paddingStart="6dp"
    android:paddingEnd="6dp">


    <!-- Inicio -->

    <LinearLayout
        android:id="@+id/navInicio"
        android:layout_width="0dp"
        android:layout_height="match_parent"

        android:layout_weight="1"

        android:gravity="center"
        android:orientation="vertical">

        <View
            android:layout_width="20dp"
            android:layout_height="3dp"

            android:layout_marginBottom="8dp"

            android:background="@color/ds_magenta" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:text="@string/nav_home"
            android:textColor="@color/ds_text_primary"
            android:textSize="12sp"
            android:textStyle="bold" />

    </LinearLayout>


    <!-- Biblioteca -->

    <LinearLayout
        android:id="@+id/navBiblioteca"
        android:layout_width="0dp"
        android:layout_height="match_parent"

        android:layout_weight="1"

        android:gravity="center"
        android:orientation="vertical">

        <View
            android:layout_width="20dp"
            android:layout_height="3dp"

            android:layout_marginBottom="8dp"

            android:background="@android:color/transparent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:text="@string/nav_library"
            android:textColor="@color/ds_text_secondary"
            android:textSize="12sp" />

    </LinearLayout>


    <!-- Listas -->

    <LinearLayout
        android:id="@+id/navListas"
        android:layout_width="0dp"
        android:layout_height="match_parent"

        android:layout_weight="1"

        android:gravity="center"
        android:orientation="vertical">

        <View
            android:layout_width="20dp"
            android:layout_height="3dp"

            android:layout_marginBottom="8dp"

            android:background="@android:color/transparent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:text="@string/nav_playlists"
            android:textColor="@color/ds_text_secondary"
            android:textSize="12sp" />

    </LinearLayout>


    <!-- Ajustes -->

    <LinearLayout
        android:id="@+id/navAjustes"
        android:layout_width="0dp"
        android:layout_height="match_parent"

        android:layout_weight="1"

        android:gravity="center"
        android:orientation="vertical">

        <View
            android:layout_width="20dp"
            android:layout_height="3dp"

            android:layout_marginBottom="8dp"

            android:background="@android:color/transparent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:text="@string/nav_settings"
            android:textColor="@color/ds_text_secondary"
            android:textSize="12sp" />

    </LinearLayout>

</LinearLayout>